      <div class="flex flex-wrap gap-2 mb-5">
        {['AI Agents', 'Agentic Workflows', 'Claude Code', 'MCP Servers', 'Anthropic Agent SDK', 'Tool-use / Function-calling', 'LLM Evals', 'Agent Governance', 'Google Vertex AI', 'Anthropic Claude API', 'OpenAI API', 'Prompt Engineering', 'RAG', 'Human-in-the-loop', 'Responsible AI'].map((t) => (
