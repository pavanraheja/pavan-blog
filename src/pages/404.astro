---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';

const latest = (await getCollection('articles'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 4);
---

<Layout title="Page not found — Pavan Raheja" description="This page has moved or doesn't exist." noindex>
  <section class="max-w-5xl mx-auto px-6 py-20">
    <div class="max-w-2xl">
      <p class="text-xs font-medium text-brand-600 uppercase tracking-wide mb-3">404</p>
      <h1 class="text-4xl font-bold text-gray-900 mb-4">This page has moved or doesn't exist</h1>
      <p class="text-gray-500 mb-8 leading-relaxed">
        If you followed an old link to my blog, it moved to this site — all posts now live under
        <a href="/articles" class="text-gray-900 underline underline-offset-2">Articles</a>.
      </p>

      <div data-cta="not-found" class="flex flex-wrap gap-3 mb-12">
        <a href="/work" class="bg-gray-900 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-700 transition-colors">
          See my work
        </a>
        <a href="/articles" class="border border-gray-200 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium hover:border-gray-400 transition-colors">
          All articles
        </a>
        <a href="/#chat" class="border border-gray-200 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium hover:border-gray-400 transition-colors">
          Talk to my clone
        </a>
      </div>

      <h2 class="text-lg font-semibold text-gray-900 mb-4">Latest writing</h2>
      <ul class="space-y-3">
        {latest.map((post) => (
          <li>
            <a href={`/articles/${post.slug}`} class="text-sm text-gray-700 hover:text-brand-600 transition-colors">
              {post.data.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <script is:inline>
    if (window.posthog && window.posthog.capture) {
      window.posthog.capture('page_not_found', { path: location.pathname, referrer: document.referrer || null });
    }
  </script>
</Layout>
