---
interface Props {
  variant?: 'inline' | 'floating';
}

const { variant = 'inline' } = Astro.props;
const floating = variant === 'floating';
const chips = ["I'm hiring / recruiting", "I'm exploring a collaboration", 'Just exploring'];
---

{floating && (
  <button
    id="chat-launcher"
    type="button"
    aria-controls="chat-panel"
    aria-expanded="false"
    class="fixed bottom-5 right-5 z-50 inline-flex items-center gap-2 bg-gray-900 text-white px-4 py-3 rounded-full text-sm font-medium shadow-lg hover:bg-gray-700 transition-colors"
  >
    💬 Ask my AI clone
  </button>
)}

<section
  id={floating ? 'chat-panel' : 'chat'}
  data-variant={variant}
  hidden={floating}
  class={floating
    ? 'fixed bottom-20 right-4 left-4 sm:left-auto sm:w-[400px] z-50 bg-white rounded-2xl border border-gray-200 shadow-2xl p-4'
    : 'max-w-5xl mx-auto px-6 py-20'}
>
  <div class={floating ? '' : 'max-w-2xl mx-auto'}>
    <div class={floating ? 'mb-3 flex items-start justify-between gap-3' : 'mb-6'}>
      <div>
        <h2 class={floating ? 'text-base font-semibold text-gray-900' : 'text-2xl font-semibold text-gray-900'}>
          Talk to my AI clone
        </h2>
        <p class={floating ? 'mt-0.5 text-gray-500 text-xs' : 'mt-1 text-gray-500 text-sm'}>
          An AI trained on my work. Tell it who you are and it'll show you what's relevant — I read the conversations and follow up personally.
        </p>
      </div>
      {floating && (
        <button id="chat-close" type="button" aria-label="Close chat" class="text-gray-400 hover:text-gray-700 text-lg leading-none px-1">
          ×
        </button>
      )}
    </div>

    <!-- Intent chips (class kept as suggested-q for PostHog click tracking) -->
    <div id="intent-chips" class={floating ? 'flex flex-wrap gap-2 mb-3' : 'flex flex-wrap gap-2 mb-4'}>
      {chips.map((q) => (
        <button
          type="button"
          class="suggested-q text-xs px-3 py-1.5 rounded-full border border-gray-200 text-gray-600 hover:border-gray-400 hover:text-gray-800 transition-colors bg-white"
        >
          {q}
        </button>
      ))}
    </div>

    <!-- Chat messages -->
    <div
      id="chat-messages"
      class={`${floating ? 'h-80' : 'h-96'} overflow-y-auto rounded-xl border border-gray-200 bg-gray-50 p-4 flex flex-col gap-3 mb-3`}
    >
      <div class="flex gap-3">
        <div class="w-7 h-7 rounded-full bg-gray-900 flex-shrink-0 flex items-center justify-center">
          <span class="text-white text-xs font-bold">P</span>
        </div>
        <div id="chat-greeting" class="bg-white rounded-xl px-4 py-3 text-sm text-gray-700 shadow-sm max-w-[85%]">
          Hi — I'm Pavan's AI clone. What brings you here: hiring, a collaboration, or just exploring?
        </div>
      </div>
    </div>

    <!-- Input -->
    <form id="chat-form" class="flex gap-2">
      <input
        id="chat-input"
        type="text"
        placeholder="Type a message..."
        autocomplete="off"
        maxlength="2000"
        class="flex-1 min-w-0 rounded-lg border border-gray-200 px-4 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-transparent"
      />
      <button
        type="submit"
        id="chat-submit"
        class="bg-gray-900 text-white px-4 py-2.5 rounded-lg text-sm font-medium hover:bg-gray-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
      >
        Send
      </button>
    </form>
  </div>
</section>

<script>
  const root = (document.getElementById('chat') ?? document.getElementById('chat-panel')) as HTMLElement;
  const floating = root.dataset.variant === 'floating';
  const form = document.getElementById('chat-form') as HTMLFormElement;
  const input = document.getElementById('chat-input') as HTMLInputElement;
  const submit = document.getElementById('chat-submit') as HTMLButtonElement;
  const messagesEl = document.getElementById('chat-messages') as HTMLDivElement;
  const chips = document.getElementById('intent-chips') as HTMLDivElement;
  const greeting = document.getElementById('chat-greeting') as HTMLDivElement;
  const launcher = document.getElementById('chat-launcher') as HTMLButtonElement | null;

  const history: { role: 'user' | 'assistant'; content: string }[] = [];
  const conversationId = crypto.randomUUID();
  let leadAlerted = 0; // which lead details have already triggered an alert to Pavan
  const posthog = () => (window as any).posthog;

  // --- Returning visitors: details they shared, kept only in their own browser ---
  type Visitor = { name?: string; company?: string; role?: string; intent?: string };
  const VISITOR_KEY = 'pavanClone.visitor';

  function loadVisitor(): Visitor | null {
    try {
      const raw = localStorage.getItem(VISITOR_KEY);
      return raw ? (JSON.parse(raw) as Visitor) : null;
    } catch {
      return null;
    }
  }

  function saveVisitor(update: Visitor) {
    const merged: Visitor = { ...(loadVisitor() ?? {}) };
    for (const [key, value] of Object.entries(update)) {
      if (typeof value === 'string' && value.trim()) (merged as Record<string, string>)[key] = value.trim().slice(0, 80);
    }
    try {
      localStorage.setItem(VISITOR_KEY, JSON.stringify(merged));
    } catch {
      /* storage unavailable — the chat still works, it just won't remember */
    }
  }

  const returning = loadVisitor();
  if (returning?.name) {
    greeting.textContent = returning.company
      ? `Welcome back, ${returning.name} — want to pick up where we left off on ${returning.company}, or start something new?`
      : `Welcome back, ${returning.name} — want to pick up where we left off, or start something new?`;
  }

  // --- Floating panel: open from the launcher or any "#chat" link on the page ---
  function openPanel(source: string) {
    if (!floating || !root.hidden) return;
    root.hidden = false;
    launcher?.setAttribute('aria-expanded', 'true');
    posthog()?.capture?.('clone_opened', { source, page: location.pathname });
    input.focus();
  }

  function closePanel() {
    root.hidden = true;
    launcher?.setAttribute('aria-expanded', 'false');
  }

  if (floating) {
    launcher?.addEventListener('click', () => (root.hidden ? openPanel('launcher') : closePanel()));
    document.getElementById('chat-close')?.addEventListener('click', closePanel);
    document.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest?.('a[href$="#chat"]');
      if (link) {
        e.preventDefault();
        openPanel('link');
      }
    });
    if (location.hash === '#chat') openPanel('hash');
  }

  document.querySelectorAll('.suggested-q').forEach((btn) => {
    btn.addEventListener('click', () => {
      input.value = (btn as HTMLElement).innerText;
      form.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
    });
  });

  // --- Rendering ---
  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  }

  // Minimal, escape-first markdown: **bold**, [links](https://…), bullet and numbered lists, paragraphs.
  function inline(s: string): string {
    return escapeHtml(s)
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(
        /\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g,
        '<a href="$2" target="_blank" rel="noopener" class="underline hover:text-gray-900">$1</a>',
      );
  }

  function renderMarkdown(text: string): string {
    const html: string[] = [];
    let list: string[] = [];
    const flush = () => {
      if (list.length) html.push(`<ul class="list-disc pl-5 space-y-1 my-1">${list.join('')}</ul>`);
      list = [];
    };
    for (const raw of text.split('\n')) {
      const line = raw.trim();
      const item = line.match(/^(?:[-*•]|\d+[.)])\s+(.*)$/);
      if (item) {
        list.push(`<li>${inline(item[1])}</li>`);
      } else if (!line) {
        flush();
      } else {
        flush();
        html.push(`<p class="my-1">${inline(line)}</p>`);
      }
    }
    flush();
    return html.join('');
  }

  const STATUS_TEXT: Record<string, string> = {
    find_applied_roles: 'Looking that up…',
    save_visitor: 'Noting that down…',
    request_call: 'Sending your request to Pavan…',
  };

  function addMessage(role: 'user' | 'assistant', text: string): HTMLElement {
    const wrapper = document.createElement('div');
    wrapper.className = 'flex gap-3' + (role === 'user' ? ' justify-end' : '');

    if (role === 'assistant') {
      const avatar = document.createElement('div');
      avatar.className = 'w-7 h-7 rounded-full bg-gray-900 flex-shrink-0 flex items-center justify-center';
      avatar.innerHTML = '<span class="text-white text-xs font-bold">P</span>';
      wrapper.appendChild(avatar);
    }

    const bubble = document.createElement('div');
    bubble.className =
      role === 'user'
        ? 'bg-gray-900 text-white rounded-xl px-4 py-3 text-sm max-w-[85%]'
        : 'bg-white rounded-xl px-4 py-3 text-sm text-gray-700 shadow-sm max-w-[85%]';
    bubble.textContent = text;
    wrapper.appendChild(bubble);

    messagesEl.appendChild(wrapper);
    messagesEl.scrollTop = messagesEl.scrollHeight;
    return bubble;
  }

  // --- Sending ---
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const text = input.value.trim();
    if (!text || submit.disabled) return;

    input.value = '';
    submit.disabled = true;
    chips.hidden = true;

    addMessage('user', text);
    history.push({ role: 'user', content: text });

    const bubble = addMessage('assistant', '');
    bubble.innerHTML = '<span class="animate-pulse text-gray-400">...</span>';

    let fullText = '';

    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          messages: history,
          conversationId,
          distinctId: posthog()?.get_distinct_id?.() ?? null,
          sessionId: posthog()?.get_session_id?.() ?? null,
          leadAlerted,
          visitor: loadVisitor(),
          page: location.pathname,
        }),
      });

      if (res.status === 429) throw new Error('rate_limited');
      if (!res.ok || !res.body) throw new Error('api_error');

      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let buffer = '';
      let failed = false;

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });
        const events = buffer.split('\n\n');
        buffer = events.pop() ?? '';
        for (const event of events) {
          if (!event.startsWith('data: ')) continue;
          const payload = JSON.parse(event.slice(6));
          if (payload.status && !fullText.trim()) {
            bubble.innerHTML = `<span class="animate-pulse text-gray-400">${escapeHtml(STATUS_TEXT[payload.status] ?? 'Thinking…')}</span>`;
          }
          if (payload.t) {
            fullText += payload.t;
            if (fullText.trim()) bubble.innerHTML = renderMarkdown(fullText);
            messagesEl.scrollTop = messagesEl.scrollHeight;
          }
          if (payload.visitor) saveVisitor(payload.visitor);
          if (typeof payload.leadAlerted === 'number') leadAlerted = payload.leadAlerted;
          if (payload.error) failed = true;
        }
      }

      if (failed && !fullText) throw new Error('api_error');
      history.push({ role: 'assistant', content: fullText });
    } catch (err) {
      history.pop();
      bubble.classList.add('text-red-500');
      bubble.textContent =
        (err as Error).message === 'rate_limited'
          ? "That's the chat limit for now — reach me directly at pavanraheja@gmail.com."
          : "The clone is having trouble right now — reach me directly on WhatsApp (+971 503860738) or at pavanraheja@gmail.com.";
    } finally {
      submit.disabled = false;
      input.focus();
    }
  });
</script>
