---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import ChatWidget from '@/components/ChatWidget.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Floating chat on every page; pages that embed the chat inline pass 'none'. */
  chat?: 'floating' | 'none';
  /** 'article' marks blog posts for social previews and adds their publish date. */
  ogType?: 'website' | 'article';
  publishedTime?: string;
  /** Keeps a page out of search results (the 404 page). */
  noindex?: boolean;
}

const {
  title = 'Pavan Raheja — AI Product Manager | AI Agents & LLM Products',
  description = 'AI Product Manager building AI agents and LLM products. 10+ years across marketplaces, SaaS, fintech, and crypto — taking products from zero to one. Based in Dubai.',
  image = '/images/og-default.png',
  jsonLd,
  chat = 'floating',
  ogType = 'website',
  publishedTime,
  noindex = false,
} = Astro.props;

// Prerendered pages build as dir/index.html, so their pathname ends in "/"; canonicals match the sitemap without it.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(path, 'https://www.pavan.blog').href;
const ogImage = new URL(image, 'https://www.pavan.blog').href;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <title>{title}</title>
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="alternate" type="application/rss+xml" title="Pavan Raheja — Articles" href="https://www.pavan.blog/rss.xml" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Pavan Raheja" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Schema.org Person -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Pavan Raheja",
        "url": "https://www.pavan.blog",
        "jobTitle": "AI Product Manager",
        "description": "AI Product Manager building AI agents and LLM products. 10+ years across marketplaces, SaaS, fintech, and crypto. Based in Dubai.",
        "sameAs": [
          "https://www.linkedin.com/in/pavanraheja",
          "https://github.com/pavanraheja"
        ]
      }
    </script>

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Non-blocking: text paints in system-ui, Inter swaps in when loaded -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    </noscript>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- PostHog analytics -->
    <script is:inline>
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog && window.posthog.__loaded)||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}p||((p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",p.onerror=function(){p=null},(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r));var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagResult isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      posthog.init('phc_maPUeEbP8NYsvtxELGhXJuPEBgs4y3b29W7znGBbdFqc', {
        api_host: 'https://eu.i.posthog.com',
        defaults: '2026-05-30',
      })
    </script>

    <!-- PostHog conversion events -->
    <script is:inline>
      (function(){
        if (window.posthog && window.posthog.register) window.posthog.register({ site: 'pavan_blog' });
        function cap(n, p){ if (window.posthog && window.posthog.capture) window.posthog.capture(n, p); }
        // Where on the page a link sits: an explicit data-cta block, else the nav or footer.
        function position(a){
          var block = a.closest('[data-cta]');
          if (block) return block.getAttribute('data-cta');
          if (a.closest('nav')) return 'nav';
          if (a.closest('footer')) return 'footer';
          return 'body';
        }
        document.addEventListener('click', function(e){
          if (!e.target || !e.target.closest) return;
          var a = e.target.closest('a');
          if (a) {
            var href = a.getAttribute('href') || '';
            var b = { link_url: href, link_text: (a.innerText || '').trim().slice(0, 80), page: location.pathname, position: position(a) };
            if (/wa\.me|api\.whatsapp\.com/i.test(href)) cap('whatsapp_click', b);
            else if (href.indexOf('mailto:') === 0) cap('email_click', b);
            else if (href.indexOf('tel:') === 0) cap('phone_click', b);
            else if (/\.(pdf|csv|xlsx?|zip|docx?)(\?|$)/i.test(href)) cap('file_download', b);
            else if (/#(access|talk|chat|start|book|contact)$/i.test(href)) cap('cta_click', b);
            else if (/^https?:\/\//i.test(href) && href.indexOf(location.hostname) === -1) cap('outbound_click', b);
            return;
          }
          if (e.target.closest('button.suggested-q')) cap('clone_suggested_question_click', { question: (e.target.closest('button.suggested-q').innerText || '').trim().slice(0, 120) });
        }, true);
        document.addEventListener('submit', function(e){
          var f = e.target;
          if (!f || f.tagName !== 'FORM') return;
          var p = { form_id: f.id || null, form_class: f.className || null, page: location.pathname };
          if (f.id === 'chat-form') cap('clone_chat_message_sent', p);
          else if (/subscribe-form/.test(f.className || '')) cap('newsletter_form_submit', p);
          else cap('form_submit', p);
        }, true);

        // Scroll depth (fires on real scrolling only, so bots that never scroll don't count).
        var marks = [25, 50, 75, 100], reached = {}, ticking = false;
        window.addEventListener('scroll', function(){
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function(){
            ticking = false;
            var el = document.documentElement;
            var max = el.scrollHeight - el.clientHeight;
            var pct = max > 0 ? Math.round((window.scrollY / max) * 100) : 100;
            marks.forEach(function(m){
              if (pct >= m && !reached[m]) { reached[m] = true; cap('scroll_depth', { percent: m, page: location.pathname }); }
            });
          });
        }, { passive: true });

        document.addEventListener('DOMContentLoaded', function(){
          // WhatsApp messages say which page they came from, so inbound chats can be traced to the site.
          var page = location.pathname === '/' ? '' : location.pathname.replace(/\/+$/, '');
          document.querySelectorAll('a[href*="wa.me/"]').forEach(function(a){
            a.href = a.href.replace('via%20pavan.blog.', 'via%20pavan.blog' + encodeURIComponent(page).replace(/%2F/g, '/') + '.');
          });
          // Blocks marked data-track-section report once when half of them is on screen.
          if (!('IntersectionObserver' in window)) return;
          var seen = {};
          var io = new IntersectionObserver(function(entries){
            entries.forEach(function(entry){
              if (!entry.isIntersecting) return;
              var section = entry.target.getAttribute('data-track-section');
              io.unobserve(entry.target);
              if (seen[section]) return;
              seen[section] = true;
              cap('section_viewed', { section: section, page: location.pathname });
            });
          }, { threshold: 0.5 });
          document.querySelectorAll('[data-track-section]').forEach(function(el){ io.observe(el); });
        });
      })();
    </script>
  </head>

  <body class="bg-white text-gray-900 font-sans antialiased">
    <nav class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-sm border-b border-gray-100">
      <div class="max-w-5xl mx-auto px-6 h-14 flex items-center justify-between">
        <a href="/" class="font-semibold text-gray-900 hover:text-brand-600 transition-colors">
          Pavan Raheja
        </a>
        <div class="flex items-center gap-6 text-sm text-gray-600">
          <a href="/work" class="hover:text-gray-900 transition-colors">Work</a>
          <a href="/articles" class="hover:text-gray-900 transition-colors">Articles</a>
          <a href="/newsletter" class="hover:text-gray-900 transition-colors">Newsletter</a>
          <a href="/about" class="hover:text-gray-900 transition-colors">About</a>
          <a href="/#contact" class="hover:text-gray-900 transition-colors">Contact</a>
          <a
            href="/#chat"
            class="bg-gray-900 text-white px-3 py-1.5 rounded-md text-xs font-medium hover:bg-gray-700 transition-colors"
          >
            Talk to me
          </a>
        </div>
      </div>
    </nav>

    <main class="pt-14">
      <slot />
    </main>

    <footer class="mt-24 border-t border-gray-100 py-10">
      <div class="max-w-5xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-gray-400">
        <span>© {new Date().getFullYear()} Pavan Raheja</span>
        <div class="flex flex-wrap gap-5">
          <a href="https://wa.me/971503860738?text=Hi%20Pavan%20%E2%80%94%20found%20you%20via%20pavan.blog." target="_blank" rel="noopener" class="hover:text-gray-700 transition-colors">WhatsApp</a>
          <a href="mailto:pavanraheja@gmail.com" class="hover:text-gray-700 transition-colors">Email</a>
          <a href="https://www.linkedin.com/in/pavanraheja" target="_blank" rel="noopener" class="hover:text-gray-700 transition-colors">LinkedIn</a>
          <a href="/articles" class="hover:text-gray-700 transition-colors">Articles</a>
          <a href="/rss.xml" class="hover:text-gray-700 transition-colors">RSS</a>
          <a href="/#chat" class="hover:text-gray-700 transition-colors">Digital Clone</a>
        </div>
      </div>
    </footer>
    {chat === 'floating' && <ChatWidget variant="floating" />}
    <Analytics />
    <SpeedInsights />
  </body>
</html>
